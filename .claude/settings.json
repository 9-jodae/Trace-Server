{
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(./gradlew.bat *)",
      "Bash(docker compose *)",
      "Bash(git status *)",
      "Bash(git branch *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git fetch *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/*.pem)",
      "Bash(git push origin main)",
      "Bash(git push origin develop)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin HEAD:develop)"
    ]
  }
}
